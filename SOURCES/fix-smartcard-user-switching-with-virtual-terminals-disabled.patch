From 559c158d0e0ad0f81552ce0e01fefa5e8c38bb8b Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Thu, 5 Nov 2026 14:19:42 +0100
Subject: [PATCH 2/2] manager: Switch to existing session before opening a new
 one

When the username isn't known until partway through the conversation
(e.g. gdm-smartcard), GDM used to only look for an existing session
after opening a new one for this login. That made gnome-shell see the
existing session as a conflicting session, instead of recognizing it as
the same user already logged in. Check for the existing session right
after credentials are established instead, and switch to it before
calling gdm_session_open_session() at all. The switch itself is exactly
the same one on_start_user_session() already did, just performed
earlier.

Backport of commit eb66ded7b195f48a4853447a987147b6a861f9c3.

Adapted for 47.0: retain chown_initial_setup_home_dir() and the
GDM_SESSION_VERIFICATION_MODE_CHOOSER case; preserve the existing
REUSE_VT session-start path.

Part-of: <https://gitlab.gnome.org/GNOME/gdm/-/merge_requests/403>
---
 daemon/gdm-manager.c | 45 +++++++++++++++++++++++---------------------
 daemon/gdm-session.c | 28 ++++++++++++++-------------
 2 files changed, 39 insertions(+), 34 deletions(-)

diff --git a/daemon/gdm-manager.c b/daemon/gdm-manager.c
index bad4e443..2ec4d321 100644
--- a/daemon/gdm-manager.c
+++ b/daemon/gdm-manager.c
@@ -1908,29 +1908,10 @@ static gboolean
 on_start_user_session (StartUserSessionOperation *operation)
 {
         GdmManager *self = operation->manager;
-        gboolean migrated;
-        gboolean fail_if_already_switched = TRUE;
         GdmDisplay *display;
         const char *session_id;
 
-        g_debug ("GdmManager: start or jump to session");
-
-        /* If there's already a session running, jump to it.
-         * If the only session running is the one we just opened,
-         * start a session on it.
-         */
-        migrated = switch_to_compatible_user_session (operation->manager, operation->session, fail_if_already_switched);
-
-        g_debug ("GdmManager: migrated: %d", migrated);
-        if (migrated) {
-                /* We don't stop the manager here because
-                   when Xorg exits it switches to the VT it was
-                   started from.  That interferes with fast
-                   user switching. */
-                gdm_session_reset (operation->session);
-                destroy_start_user_session_operation (operation);
-                goto out;
-        }
+        g_debug ("GdmManager: start session");
 
         display = get_display_for_user_session (operation->session);
 
@@ -2001,7 +1982,6 @@ on_start_user_session (StartUserSessionOperation *operation)
 
         start_user_session (operation->manager, operation);
 
- out:
         return G_SOURCE_REMOVE;
 }
 
@@ -2052,7 +2032,9 @@ on_session_credentials_established (GdmSession *session,
                                     GdmManager *manager)
 {
         GdmDisplay *display;
+        const char *username;
         gboolean    doing_initial_setup = FALSE;
+        gboolean    switched;
 
         display = get_display_for_user_session (session);
         if (display == NULL) {
@@ -2068,6 +2050,27 @@ on_session_credentials_established (GdmSession *session,
                       NULL);
         if (doing_initial_setup)
                 chown_initial_setup_home_dir ();
+
+        /* The username may only have become known partway through this
+         * conversation, e.g. when it's auto-selected by a PAM service like
+         * gdm-smartcard. If it turns out a compatible session for that user
+         * is already running, this login attempt is redundant: jump to the
+         * existing session instead and discard this conversation.
+         */
+        username = gdm_session_get_username (session);
+        if (username == NULL)
+                return;
+
+        switched = switch_to_compatible_user_session (manager, session, TRUE);
+        if (switched) {
+                g_debug ("GdmManager: user %s already has a compatible session running, "
+                         "switching to it instead of completing this login attempt",
+                         username);
+                gdm_session_reset (session);
+        } else {
+                g_debug ("GdmManager: unable to switch to session, "
+                         "letting this conversation finish normally");
+        }
 }
 
 static void
diff --git a/daemon/gdm-session.c b/daemon/gdm-session.c
index acff2ac2..6127f0d2 100644
--- a/daemon/gdm-session.c
+++ b/daemon/gdm-session.c
@@ -342,20 +342,22 @@ on_establish_credentials_cb (GdmDBusWorker *proxy,
                                service_name,
                                conversation->worker_pid);
 
-                switch (self->verification_mode) {
-                case GDM_SESSION_VERIFICATION_MODE_LOGIN:
-                case GDM_SESSION_VERIFICATION_MODE_CHOOSER:
-                        gdm_session_open_session (self, service_name);
-                        break;
-                case GDM_SESSION_VERIFICATION_MODE_REAUTHENTICATE:
-                        if (self->user_verifier_interface != NULL) {
-                                gdm_dbus_user_verifier_emit_verification_complete (self->user_verifier_interface,
-                                                                                   service_name);
-                                g_signal_emit (self, signals[VERIFICATION_COMPLETE], 0, service_name);
+                if (g_hash_table_lookup (self->conversations, service_name) == conversation) {
+                        switch (self->verification_mode) {
+                        case GDM_SESSION_VERIFICATION_MODE_LOGIN:
+                        case GDM_SESSION_VERIFICATION_MODE_CHOOSER:
+                                gdm_session_open_session (self, service_name);
+                                break;
+                        case GDM_SESSION_VERIFICATION_MODE_REAUTHENTICATE:
+                                if (self->user_verifier_interface != NULL) {
+                                        gdm_dbus_user_verifier_emit_verification_complete (self->user_verifier_interface,
+                                                                                           service_name);
+                                        g_signal_emit (self, signals[VERIFICATION_COMPLETE], 0, service_name);
+                                }
+                                break;
+                        default:
+                                break;
                         }
-                        break;
-                default:
-                        break;
                 }
         } else {
                 report_and_stop_conversation (self, service_name, error);
-- 
