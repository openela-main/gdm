+++ b/daemon/gdm-remote-display-factory.c
@@ -80,8 +80,26 @@ gdm_remote_display_factory_create_display (GdmRemoteDisplayFactory *factory,
 static gboolean
 handle_create_remote_display (GdmDBusRemoteDisplayFactory *skeleton,
                               GDBusMethodInvocation       *invocation,
-                              GVariant                    *properties,
+                              const char                  *remote_id,
                               GdmRemoteDisplayFactory     *factory)
+{
+        if (!gdm_remote_display_factory_create_display (factory, NULL, remote_id, NULL))
+                g_dbus_method_invocation_return_error_literal (invocation,
+                                                               G_DBUS_ERROR,
