From bed97d719c9822b7bb9b14f048a82770967fa81e Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Fri, 4 Sep 2026 20:12:39 +0200
Subject: [PATCH 7/8] remote-display-factory: Reuse display when autologin-user
 exits

When gnome-remote-desktop requests to create a new RemoteDisplay with
a remote_id and an autologin_user there can be two cases:
  1. There's not any remote display with that user: create new
     RemoteDisplay.
  2. There's already a remote display with that user: update the
     remote_id of that display to trigger a new handover for the new
     connection which is requesting to create the RemoteDisplay.

Case 1 was covered. This covers case 2.

Part-of: <https://gitlab.gnome.org/GNOME/gdm/-/merge_requests/399>
---
 daemon/gdm-remote-display-factory.c | 32 ++++++++++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/daemon/gdm-remote-display-factory.c b/daemon/gdm-remote-display-factory.c
index a44721c9a..bf6bac4d9 100644
--- a/daemon/gdm-remote-display-factory.c
+++ b/daemon/gdm-remote-display-factory.c
@@ -48,6 +48,19 @@ static gpointer remote_display_factory_object = NULL;
 
 G_DEFINE_TYPE (GdmRemoteDisplayFactory, gdm_remote_display_factory, GDM_TYPE_DISPLAY_FACTORY)
 
+static gboolean
+lookup_by_autologin_user (const char *id,
+                          GdmDisplay *display,
+                          gpointer    user_data)
+{
+        const char *autologin_user = user_data;
+        g_autofree char *display_autologin_user = NULL;
+
+        g_object_get (display, "autologin-user", &display_autologin_user, NULL);
+
+        return g_strcmp0 (autologin_user, display_autologin_user) == 0;
+}
+
 static gboolean
 gdm_remote_display_factory_create_display (GdmRemoteDisplayFactory *factory,
                                            const char              *autologin_user,
@@ -57,6 +70,24 @@ gdm_remote_display_factory_create_display (GdmRemoteDisplayFactory *factory,
         g_autoptr (GdmDisplay) display = NULL;
         GdmDisplayStore *store;
 
+        store = gdm_display_factory_get_display_store (GDM_DISPLAY_FACTORY (factory));
+
+        if (autologin_user != NULL && remote_id != NULL) {
+                GdmDisplay *existing_display;
+
+                existing_display = gdm_display_store_find (store,
+                                                           lookup_by_autologin_user,
+                                                           (gpointer) autologin_user);
+
+                if (existing_display != NULL && GDM_IS_REMOTE_DISPLAY (existing_display)) {
+                        g_debug ("GdmRemoteDisplayFactory: Found existing remote display for "
+                                 "autologin user '%s', reusing it", autologin_user);
+
+                        gdm_remote_display_set_remote_id (GDM_REMOTE_DISPLAY (existing_display), remote_id);
+                        return TRUE;
+                }
+        }
+
         g_debug ("GdmRemoteDisplayFactory: Creating remote display");
 
         display = gdm_remote_display_new (remote_id,
@@ -66,7 +97,6 @@ gdm_remote_display_factory_create_display (GdmRemoteDisplayFactory *factory,
                       "autologin-user", autologin_user,
                       NULL);
 
-        store = gdm_display_factory_get_display_store (GDM_DISPLAY_FACTORY (factory));
         gdm_display_store_add (store, display);
 
         if (!gdm_display_prepare (display)) {
