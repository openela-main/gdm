+                               GVariant                    *properties,
+                               GdmRemoteDisplayFactory     *factory)
 {
         g_autofree char *remote_id = NULL;
         g_autofree char *remote_hostname = NULL;
@@ -108,8 +126,8 @@ handle_create_remote_display (GdmDBusRemoteDisplayFactory *skeleton,
                                                                G_DBUS_ERROR_FAILED,
                                                                "Error creating remote display");
         else
-                gdm_dbus_remote_display_factory_complete_create_remote_display (factory->skeleton,
-                                                                                invocation);
+                gdm_dbus_remote_display_factory_complete_create_remote_display2 (factory->skeleton,
