---
 daemon/gdm-manager.c | 27 ++++++++-------------------
 1 file changed, 8 insertions(+), 19 deletions(-)

diff --git a/daemon/gdm-manager.c b/daemon/gdm-manager.c
index e455dad36..0913f7a50 100644
