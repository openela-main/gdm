From 4803af294e5478d81527f7407572ee9f8d1e8776 Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Mon, 16 Nov 2026 19:13:21 +0100
Subject: [PATCH] display-factory: Require polkit authorization for
 CreateRemoteDisplay

CreateRemoteDisplay only relied on D-Bus bus policy, so any gdm-group
process, e.g. a GNOME Shell extension running in the greeter session,
could call it with a preauthenticated-user property and start a full
session for an arbitrary user without ever authenticating. Extend
authorize_manage_user_displays(), already enforced for
CreateUserDisplay/DestroyUserDisplay, to cover this method too.

CVE: CVE-2026-132858
---
 daemon/gdm-display-factory.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/daemon/gdm-display-factory.c b/daemon/gdm-display-factory.c
index 2a1c1b2b3..3dcff3dac 100644
--- a/daemon/gdm-display-factory.c
+++ b/daemon/gdm-display-factory.c
@@ -176,6 +176,7 @@ gdm_display_factory_authorize_manage_user_displays (GdmDisplayFactory      *fact
         g_autoptr (PolkitSubject) subject = NULL;
         g_autoptr (PolkitDetails) details = NULL;
         g_autoptr (GError) local_error = NULL;
+        g_autoptr (GVariant) properties = NULL;
         const char *user = NULL;
         const char *action;
         const char *method;
@@ -188,7 +189,8 @@ gdm_display_factory_authorize_manage_user_displays (GdmDisplayFactory      *fact
 
         method = g_dbus_method_invocation_get_method_name (invocation);
         if (g_strcmp0 (method, "CreateUserDisplay") != 0 &&
-            g_strcmp0 (method, "DestroyUserDisplay") != 0)
+            g_strcmp0 (method, "DestroyUserDisplay") != 0 &&
+            g_strcmp0 (method, "CreateRemoteDisplay") != 0)
                 return TRUE;
 
         if (!ensure_polkit_authority (factory, &local_error)) {
@@ -201,9 +203,17 @@ gdm_display_factory_authorize_manage_user_displays (GdmDisplayFactory      *fact
         priv = gdm_display_factory_get_instance_private (factory);
 
         parameters = g_dbus_method_invocation_get_parameters (invocation);
-        g_variant_get (parameters, "(s)", &user);
         details = polkit_details_new ();
-        polkit_details_insert (details, "user", user);
+
+        if (g_strcmp0 (method, "CreateRemoteDisplay") == 0) {
+                g_variant_get (parameters, "(@a{sv})", &properties);
+                g_variant_lookup (properties, "preauthenticated-user", "s", &user);
+        } else {
+                g_variant_get (parameters, "(s)", &user);
+        }
+
+        if (user != NULL)
+                polkit_details_insert (details, "user", user);
 
         sender = g_dbus_method_invocation_get_sender (invocation);
         subject = polkit_system_bus_name_new (sender);
-- 
2.56.1

